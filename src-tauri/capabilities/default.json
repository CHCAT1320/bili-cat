{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.bilibili.com/*" },
        { "url": "https://*.biligame.com/*" },
        { "url": "https://*.bilivideo.com/*" },
        { "url": "https://*.biliplus.com/*" },
        { "url": "https://*.hdslb.com/*" },
        { "url": "https://*.biliapi.net/*" }
      ]
    }
  ]
}
